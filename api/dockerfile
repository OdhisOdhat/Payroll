# =============================================================================
# Dockerfile – Node.js/Express backend (payroll API)
# Multi-stage → small, secure production image
# =============================================================================

# ─── Builder Stage ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first → great caching
COPY package*.json ./
RUN npm ci --omit=dev

# Copy source
COPY . .

# If you use TypeScript → uncomment:
# RUN npm run build

# ─── Production Stage ────────────────────────────────────────────────────────
FROM node:20-alpine AS production

# Create non-root user (security best practice)
RUN addgroup -g 1001 nodejs && \
    adduser -S appuser -u 1001 -G nodejs

WORKDIR /app

# Copy built/necessary files only
COPY --from=builder --chown=appuser:nodejs /app /app

USER appuser

EXPOSE 4000

# Production start command (adjust if your package.json "start" is different)
CMD ["npm", "start"]